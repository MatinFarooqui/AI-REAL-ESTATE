# Required application settings
MONGO_URI=
SECRET_KEY=

# Optional administrator account
ADMIN_EMAIL=

# Email verification service
APP_BASE_URL=http://127.0.0.1:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=0
EMAIL_FROM=

# Flask session cookie setting; use secure cookies on HTTPS deployments
SESSION_COOKIE_SECURE=

# Configure in Vercel for the Blob upload function; do not commit a real token
BLOB_READ_WRITE_TOKEN=
